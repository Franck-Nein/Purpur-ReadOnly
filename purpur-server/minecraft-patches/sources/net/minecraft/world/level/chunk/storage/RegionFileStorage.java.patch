+    private boolean detectReadOnly(final Path folder, final RegionStorageInfo info) {
+        if (!Files.exists(folder)) {
+            return false;
+        }
+        try {
+            if (!Files.isWritable(folder)) {
+                return true;
+            }
+        } catch (Exception ignored) {
+            // If we cannot determine writability, fall back to the configured toggle below.
+        }
+
+        final String configured = System.getProperty("purpur.read-only-worlds", "");
+        if (!configured.isEmpty()) {
+            for (final String token : configured.split(",")) {
+                final String candidate = token.trim();
+                if (candidate.isEmpty()) {
+                    continue;
+                }
+                if (candidate.equalsIgnoreCase(info.level())
+                    || candidate.equalsIgnoreCase(folder.getFileName().toString())) {
+                    return true;
+                }
+            }
+        }
+        return false;
     }
 
